rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Denial ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    // Admin check: robustly verify admin role in user profile
    function isAdmin() { 
      return isSignedIn() && isVerified() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == 'muhammedhmad111@gmail.com'
      );
    }
    
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.role in ['user', 'admin'] &&
             data.email is string && data.email.size() <= 128;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['title', 'description', 'price', 'category', 'stock']) &&
             data.title is string && data.title.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.stock is int && data.stock >= 0;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'total', 'status']) &&
             data.userId is string &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'userId', 'rating', 'comment', 'createdAt']) &&
             data.productId is string &&
             data.userId == request.auth.uid &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.createdAt == request.time;
    }

    function isValidCollection(data) {
      return data.keys().hasAll(['title', 'slug']) &&
             data.title is string && data.title.size() <= 100 &&
             data.slug is string && data.slug.size() <= 100;
    }

    function isValidInventoryMovement(data) {
      return data.keys().hasAll(['productId', 'type', 'change']) &&
             data.productId is string &&
             data.type in ['sale', 'restock', 'adjustment', 'refund'] &&
             data.change is int;
    }

    function isValidMarketingCampaign(data) {
      return data.keys().hasAll(['title', 'type', 'status']) &&
             data.title is string &&
             data.type in ['email', 'banner', 'social'] &&
             data.status in ['draft', 'active', 'completed'];
    }

    // --- Matches ---
    
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().role == 'user' || request.auth.token.email == 'muhammedhmad111@gmail.com'
      );
      allow update: if (isOwner(userId) || isAdmin()) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']) && isOwner(userId)) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['role']) && isAdmin())
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidProduct(incoming());
    }

    match /orders/{orderId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidOrder(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /products/{productId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming()) && 
                   exists(/databases/$(database)/documents/products/$(productId));
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin() && isValidCollection(incoming());
    }

    match /inventory/{movementId} {
      allow read, write: if isAdmin() && isValidInventoryMovement(incoming());
    }

    match /marketing/{campaignId} {
      allow read, write: if isAdmin() && isValidMarketingCampaign(incoming());
    }

    match /settings/store {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
